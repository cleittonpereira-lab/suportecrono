// Banco D1 LOCAL (simulado em .wrangler/state/v3), para os comandos de
// desenvolvimento — nada aqui chega à produção:
//   npx wrangler d1 migrations apply DB --local --config wrangler.dev.jsonc
//   node scripts/preview-d1.mjs   (app compilado no runtime do Cloudflare + este banco)
//
// O `npm run dev` (vite) NÃO usa este arquivo: nele o app roda em Node, sem os
// recursos do Cloudflare, e continua com o Drive/modo offline.
//
// NÃO se chama wrangler.jsonc de propósito: a publicação usa só a configuração
// gerada pelo nitro, e um wrangler.jsonc na raiz seria misturado a ela.
{
  "name": "gestao-dev",
  "compatibility_date": "2025-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "suportecrono-dados",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/d1"
    }
  ],
  "vars": {
    "DADOS_NO_D1": "1"
  }
}
